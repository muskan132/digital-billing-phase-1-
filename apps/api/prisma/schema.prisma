generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  EXTERNAL
  INTERNAL
}

enum UserRole {
  STORE_STAFF
  MERCHANT_ADMIN
  OPS_SUPPORT
  PLATFORM_ADMIN
}

enum BillType {
  RECEIPT
  TAX_INVOICE
}

enum TemplateSkeleton {
  MINIMALIST
  COMPACT_THERMAL
  TAX_COMPLIANT
}

enum OrderStatus {
  SUCCESS
  NON_SUCCESS
}

enum Channel {
  SMS
  EMAIL
}

enum BroadcastStatus {
  PENDING
  SENT
  FAILED
}

enum OrderSource {
  PG_CALLBACK
  DIRECT_API
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model Merchant {
  id                String     @id @default(cuid())
  jiopayMid         String     @unique
  name              String
  secretKeyEnc      Bytes
  users             User[]
  templates         Template[]
  orders            Order[]
  defaultChannel    Channel    @default(EMAIL)
  defaultTemplateId String?
  defaultTemplate   Template?  @relation("MerchantDefault", fields: [defaultTemplateId], references: [id])
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  gstin             String?
  gstStateCode      String?
  supportEmail      String?
  supportPhone      String?
  apiKeys           MerchantApiKey[]
  bills             Bill[]
  createdAt         DateTime   @default(now())
}

model User {
  id         String    @id @default(cuid())
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  type       UserType
  role       UserRole
  email      String    @unique
  createdAt  DateTime  @default(now())
}

model Template {
  id           String           @id @default(cuid())
  merchantId   String?
  merchant     Merchant?        @relation(fields: [merchantId], references: [id])
  name         String
  billType     BillType
  layoutSchema Json
  skeleton     TemplateSkeleton @default(MINIMALIST)
  version      Int              @default(1)
  bills        Bill[]
  defaultOf    Merchant[]       @relation("MerchantDefault")
  createdAt    DateTime         @default(now())
}

model Order {
  id                     String      @id @default(cuid())
  merchantId             String
  merchant               Merchant    @relation(fields: [merchantId], references: [id])
  idempotencyKey         String?
  merchantTxnNo          String?
  paymentId              String?
  txnId                  String?     @unique
  externalTransactionId  String?     @unique
  source                 OrderSource @default(PG_CALLBACK)
  saleAt                 DateTime?
  amountPaise            BigInt?
  currency               String      @default("INR")
  responseCode           String?
  paymentMode            String?
  paymentDateTime        String?
  status                 OrderStatus
  customerMobile_pii     String?
  customerEmail_pii      String?
  rawCallback            Json
  bill                   Bill?
  items                  OrderItem[]
  link                   Link?
  broadcasts             Broadcast[]
  createdAt              DateTime    @default(now())

  @@index([merchantId])
}

model OrderItem {
  id                     String   @id @default(cuid())
  orderId                String
  order                  Order    @relation(fields: [orderId], references: [id])
  lineNo                 Int
  name                   String
  hsn                    String
  uom                    String
  quantity               Int
  unitPricePaise         BigInt
  itemDiscountPaise      BigInt
  billDiscountAllocPaise BigInt
  taxRateBp              Int
  taxableValuePaise      BigInt
  taxPaise               BigInt
  cgstPaise              BigInt
  sgstPaise              BigInt
  igstPaise              BigInt
  createdAt              DateTime @default(now())

  @@index([orderId])
}

model Bill {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  billType       BillType
  templateId     String
  template       Template @relation(fields: [templateId], references: [id])
  totalPaise     BigInt
  currency       String   @default("INR")
  invoiceNumber  String?
  subtotalPaise  BigInt?
  discountPaise  BigInt?
  taxPaise       BigInt?
  cgstPaise      BigInt?
  sgstPaise      BigInt?
  igstPaise      BigInt?
  placeOfSupply  String?
  merchantGstin  String?
  snapshot       Json
  artifactVer    Int      @default(1)
  createdAt      DateTime @default(now())

  @@unique([merchantId, invoiceNumber])
}

model Link {
  id         String   @id @default(cuid())
  identifier String   @unique
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  createdAt  DateTime @default(now())
}

model MerchantApiKey {
  id         String       @id @default(cuid())
  merchantId String
  merchant   Merchant     @relation(fields: [merchantId], references: [id])
  keyPrefix  String       @unique
  keyHash    Bytes
  status     ApiKeyStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())

  @@index([merchantId])
}

model Broadcast {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  channel   Channel
  recipient String
  status    BroadcastStatus @default(PENDING)
  attempts  Int             @default(0)
  error     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sentAt    DateTime?

  @@index([status, createdAt])
}

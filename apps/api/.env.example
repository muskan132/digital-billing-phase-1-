DATABASE_URL="postgresql://billing:billing@localhost:5432/billing"
SECRET_KEY="dev-local-secret-key-change-me"
PUBLIC_BILL_BASE_URL="http://localhost:3000"

# A-1/A-2 (OIDC RP, D-42/D-52): must match apps/dev-idp's own issuer/client_id/
# redirect_uris exactly (apps/dev-idp/src/main.ts) — these are the DEV_IDP_ISSUER
# and DEV_IDP_REDIRECT_URI defaults that file already falls back to if unset,
# restated here as apps/api's own client-side config, not a new pair of values.
OIDC_ISSUER="http://localhost:9000"
OIDC_CLIENT_ID="digital-billing-portal"
OIDC_REDIRECT_URI="http://localhost:4000/auth/callback"
